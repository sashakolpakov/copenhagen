  "run": {
    "algorithms": [
      "annoy",
      "hnswlib",
      "copenhagen"
    ],
    "count": 10,
    "runs": 1,
    "parallelism": 8,
    "timeout_seconds": 7200,
    "force": true,
    "batch": false,
    "local": false,
    "run_disabled": true,
    "max_n_algorithms": -1,
    "log_dir": "benchmarks/remote_logs"
  },
  "orchestrator": {
    "baseline_parallelism": 8,
    "followup_parallelism": 4,
    "max_concurrent_followups": 6
  },
  "monitor": {
    "poll_seconds": 60,
    "stall_minutes": 60,
    "min_free_disk_gb": 20,
    "stop_on_stall": false,
    "stop_on_low_disk": true
  },
  "policy": {
    "baseline_algorithm": "copenhagen",
    "baseline_multiplier": 1.15,
    "skip_rest_if_baseline_fails": true
  },
  "export": {
    "remote_artifact_dir": "artifacts/concurrent-check",
    "plot_each_dataset": true
  },
  "download": {
    "paths": [
      "results",
      "figures"
    ],
    "skip_download": false
  }
